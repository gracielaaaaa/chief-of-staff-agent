{
  "paused": false,
  "dry_run": false,
  "timezone": "America/Los_Angeles",
  "working_hours": {
    "start": "08:00",
    "end": "21:00"
  },
  "protected": {
    "calendar_ids": [
      "primary"
    ],
    "color_ids": [
      "3",
      "5",
      "7",
      "9"
    ],
    "color_names": [
      "Grape (purple): classes",
      "Banana (yellow): GSI and reader work",
      "Peacock, Blueberry (blue)"
    ],
    "weekly_blocks": [
      {
        "day": "TUE",
        "start": "14:30",
        "end": "15:30",
        "label": "Office hours"
      }
    ]
  },
  "capture": {
    "address_suffix": "+inbox",
    "label": "Agent/Inbox",
    "done_label": "Agent/Done",
    "pause_subject": "PAUSE AGENT",
    "accept_from": "lane_context:My addresses"
  },
  "drive": {
    "root_folder_name": "Chief of Staff",
    "files": {
      "ledger": "Ledger",
      "run_log": "Run Log",
      "state": "_State",
      "look_into_later": "Look Into Later",
      "style_guide": "Style Guide",
      "lane_context": "Lane Context",
      "pricing": "Pricing",
      "consulting_templates": "Consulting Templates"
    },
    "folders": [
      "Courses",
      "Briefs",
      "Review",
      "Consulting"
    ]
  },
  "defaults": {
    "i_owe_due_business_days": 3,
    "task_durations_min": [
      15,
      30,
      60,
      90
    ],
    "reminder_minutes": 10,
    "chunk_minutes": [
      30,
      60
    ],
    "draft_rejected_after_days": 7,
    "style_rule_activation_count": 2,
    "transcript_char_cap": 30000,
    "canvas_sync_stale_days": 8
  },
  "exclusions": {
    "sender_domains": [
      "servicenow.com"
    ],
    "keywords": [
      "ServiceNow"
    ]
  },
  "models": {
    "classify": "haiku",
    "promise_detection": "haiku",
    "draft": "sonnet",
    "recap": "sonnet",
    "edit_learning": "sonnet",
    "needs_reply": "haiku",
    "consulting_synthesis": "sonnet",
    "proposal": "sonnet",
    "pricing_frame": "sonnet",
    "fact_check": "haiku",
    "confidentiality": "haiku"
  },
  "inbox_triage": {
    "enabled": true,
    "first_run_lookback": "2d",
    "max_drafts_per_run": null,
    "query": "in:inbox -from:me -category:promotions -category:social -category:updates -category:forums -label:<Agent/Inbox id> -label:<Agent/Skipped id>",
    "skip_sender_patterns": [
      "noreply",
      "no-reply",
      "donotreply",
      "notifications",
      "calendar-notification",
      "mailer-daemon",
      "bounce"
    ],
    "priority": [
      "instructor",
      "client",
      "student",
      "teammate",
      "other"
    ]
  },
  "steps": {
    "capture_notes": true,
    "inbox_triage": true,
    "course_deadlines": true,
    "ledger": true
  },
  "consulting": {
    "agent_folder": "Consulting",
    "max_questions": 12,
    "call_minutes": 30,
    "call_options": 3,
    "call_window": {
      "start": "09:00",
      "end": "17:00"
    },
    "call_search_business_days": 10
  }
}

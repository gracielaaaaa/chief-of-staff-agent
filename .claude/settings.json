{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrail.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*wpcom-mcp-(pages|posts)-create",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrail.py\" post"
          }
        ]
      }
    ]
  }
}
